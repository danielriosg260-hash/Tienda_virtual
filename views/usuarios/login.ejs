<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión - Tienda Virtual</title>
</head>
<body>

    <h1>Iniciar sesión</h1>

    <form action="/usuarios/login" method="POST">

        <label for="email">Correo:</label>
        <input
            type="email"
            id="email"
            name="email"
            required
        >

        <br><br>

        <label for="password">Contraseña:</label>
        <input
            type="password"
            id="password"
            name="password"
            required
        >

        <br><br>

        <button type="submit">
            Iniciar sesión
        </button>

    </form>

    <br>

    <a href="/usuarios/registro">
        Crear una cuenta
    </a>

</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= producto ? "Editar producto" : "Nuevo producto" %></title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header>
        <h1><%= producto ? "Editar producto" : "Nuevo producto" %></h1>
    </header>

    <main>
        <form action="/productos<%= producto ? "/" + producto._id : "" %>" method="POST" class="formulario">
            <label>
                Nombre
                <input type="text" name="nombre" value="<%= producto ? producto.nombre : "" %>" required>
            </label>

            <label>
                Descripción
                <textarea name="descripcion" required><%= producto ? producto.descripcion : "" %></textarea>
            </label>

            <label>
                Precio (S/)
                <input type="number" step="0.01" name="precio" value="<%= producto ? producto.precio : "" %>" required>
            </label>

            <label>
                Imagen (URL)
                <input type="text" name="imagen" value="<%= producto ? producto.imagen : "" %>">
            </label>

            <button type="submit" class="btn">Guardar</button>
            <a class="btn btn-secundario" href="/productos">Cancelar</a>
        </form>
    </main>
</body>
</html>
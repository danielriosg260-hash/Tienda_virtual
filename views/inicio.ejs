<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tienda Virtual</title>
</head>
<body>
    <h1>Tienda virtual funcionando</h1>

    <% if (usuario) { %>
        <p>Bienvenido, <%= usuario %>.</p>
        <form action="/usuarios/logout" method="POST">
            <button type="submit">Cerrar sesión</button>
        </form>
    <% } else { %>
        <a href="/usuarios/login">Iniciar sesión</a>
        <a href="/usuarios/registro">Crear una cuenta</a>
    <% } %>
</body>
</html>
